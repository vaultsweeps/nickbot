NODE_ENV=production
# Only used by scripts/dev-server.ts (local development); Vercel ignores it.
PORT=3000

# From @BotFather
TELEGRAM_BOT_TOKEN=
# 16-256 chars of A-Z a-z 0-9 _ - ; generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TELEGRAM_WEBHOOK_SECRET=
# Bot username without the @
TELEGRAM_BOT_USERNAME=
# Staff supergroup id (Topics enabled), looks like -1001234567890
TELEGRAM_STAFF_GROUP_ID=
# OPTIONAL. Leave empty to let every member of the staff group answer customers.
# Set comma-separated numeric Telegram user ids (e.g. 111111111,222222222) to restrict it to those people.
TELEGRAM_ALLOWED_STAFF_IDS=

SUPABASE_URL=https://your-project-ref.supabase.co
# Server-side secret key (Settings > API). Never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# Production origin, https, no trailing slash, e.g. https://your-project.vercel.app
APP_BASE_URL=
WEBHOOK_PATH=/api/telegram/webhook

# Protects /api/cron/retry. Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

LOG_LEVEL=info
